# ONES — Hostinger (LiteSpeed/Apache)
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes

RewriteEngine On
# www -> bez www (HTTPS wlacza Hostinger: "Force HTTPS"; nie ruszamy /.well-known dla certyfikatu SSL)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [L,R=301]

# Cache: HTML krótko, zasoby długo
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
