---
import Base from '../layouts/Base.astro';
import { site, u } from '../lib/site.js';
const person = site.contact_person;
const tel = person.phone.replace(/\s/g, '');
const wa = `https://wa.me/${tel.replace('+', '')}`;
---
<Base title="Contact" current="/contact/" description="Contact ONES — international production and service company. Offices in Barcelona, Warsaw and Bangkok.">
  <h1 class="sr-only">Contact</h1>
  <section class="article contact-top">
    <div class="wrap article__grid">
      <div>
        <p class="eyebrow">Send a brief</p>
        <h2 class="display" style="font-size:clamp(28px,3.4vw,44px)">Tell us about the project.</h2>
        <form class="contact-form" method="post" action={u('/contact.php')} data-contact-form>
          <label>Name<input type="text" name="name" required autocomplete="name"></label>
          <label>Email<input type="email" name="email" required autocomplete="email"></label>
          <label>Company<input type="text" name="company" autocomplete="organization"></label>
          <label>Message<textarea name="message" rows="6" required></textarea></label>
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
          <p><button class="btn" type="submit">Send →</button></p>
        </form>
      </div>
      <aside class="article__aside contact-person">
        <p class="eyebrow">Talk to us</p>
        <h3 class="contact-person__name">{person.name}</h3>
        <p class="contact-person__role">{person.role}</p>
        <p class="contact-person__phone"><a href={`tel:${tel}`}>{person.phone}</a></p>
        <a class="wa-btn" href={wa} target="_blank" rel="noopener">
          <img src={u('/media/whatsapp.svg')} alt="" width="22" height="22">
          <span>Chat on WhatsApp</span>
        </a>
      </aside>
    </div>
  </section>
  <section class="contact" aria-label="Offices">
    <div class="wrap">
      <p class="eyebrow">Offices</p>
      <ul class="contact__grid" role="list">
        {site.offices.map((o) => (
          <li class="office">
            <h3>{o.city}</h3>
            <p><b>{o.company}</b><br>{o.lines.map((l) => <>{l}<br /></>)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
