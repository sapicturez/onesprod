---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tile from '../components/Tile.astro';
import { site, productionReel } from '../lib/site.js';
const spots = productionReel();
const regions = [
  ['poland', 'Poland', 'Warsaw · Central & Eastern Europe', site.production_poland_html],
  ['asia', 'Asia', 'Bangkok · Thailand & South East Asia', site.production_asia_html],
  ['spain', 'Spain', 'Barcelona · Iberia & Southern Europe', site.production_spain_html],
];
---
<Base title="Production Service" current="/production-service/" description="Full service production and line producing by ONES in Poland, Thailand & South East Asia and Spain — location scouting, permits, casting, crews, budgeting.">
  <PageHero eyebrow="Production Service" title="We produce wherever the story takes us." lede="Full service production and line producing in Poland, South&nbsp;East&nbsp;Asia and Spain. One European producer from ONES with you from the first call to delivery." />
  <section aria-label="Regions" style="padding-bottom:clamp(40px,6vh,80px)">
    <div class="wrap">
      <div class="ps-regions">
        {regions.map(([slug, name, sub, body]) => (
          <article class="ps-region" id={slug}>
            <p class="eyebrow">{sub}</p>
            <h2>Production service in {name}</h2>
            <div class="ps-region__body" set:html={body}></div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="work work--list" aria-labelledby="ps-reel-h" style="padding-top:0;padding-bottom:clamp(60px,10vh,100px)">
    <div class="wrap section-head">
      <h2 id="ps-reel-h" class="display">Produced as service.</h2>
      <span class="count">{spots.length} spots</span>
    </div>
    <div class="reel reel--tight">
      {spots.map((p, i) => <Tile item={p} group="ps" eager={i < 3} />)}
    </div>
  </section>
</Base>
