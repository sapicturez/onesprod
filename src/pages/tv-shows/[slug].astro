---
import Base from '../../layouts/Base.astro';
import { tvShows, u, creditPairs, vimeoEmbed, vimeoHash } from '../../lib/site.js';
export function getStaticPaths() {
  const items = tvShows();
  return items.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: items[i - 1] || items[items.length - 1], next: items[i + 1] || items[0] } }));
}
const { p, prev, next } = Astro.props;
const credits = creditPairs(p.credits);
const gallery = (p.gallery_local || []).map((g) => u(g));
const body = p.text_html.replace(/^\s*<h\d[^>]*>[\s\S]*?<\/h\d>/, '');
const excerpt = p.text.slice(0, 155);
---
<Base title={p.title} current="/tv-shows/" description={excerpt} ogImage={p.thumb_local}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">TV Show · {p.year}</p>
      <h1 class="display">{p.title}</h1>
    </div>
  </section>
  <section class="article">
    <div class="wrap article__grid">
      <div>
        {p.vimeo ? (
          <div class="video-embed"><iframe src={vimeoEmbed(p.vimeo).replace('autoplay=1', 'autoplay=0')} title={p.title} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>
        ) : (
          <div class="video-embed"><img src={u(p.thumb_local)} alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"></div>
        )}
        <div class="article__body" set:html={body}></div>
        {gallery.length > 0 && (
          <div class="gallery gallery--wide">
            {gallery.map((g, i) => <a href={g} data-gallery="[]" data-title={`${p.title} — ${i + 1}`}><img src={g.replace('.webp', '-sm.webp')} alt="" loading="lazy" decoding="async"></a>)}
          </div>
        )}
      </div>
      <aside class="article__aside">
        {credits.length > 0 && <ul class="credits">{credits.map(([k, v]) => <li><b>{k}</b><span>{v}</span></li>)}</ul>}
        {p.vimeos.length > 1 && (
          <div style="margin-top:24px">
            <p class="eyebrow">More episodes</p>
            {p.vimeos.slice(1).map((v, i) => <p><a href="#" data-video-open={v} data-vh={vimeoHash(v) || undefined} data-title={`${p.title} — part ${i + 2}`} class="btn btn--ghost">▶ Watch part {i + 2}</a></p>)}
          </div>
        )}
      </aside>
    </div>
    <div class="wrap pager">
      <a href={u(`/tv-shows/${prev.slug}/`)}><span>Previous</span>← {prev.title}</a>
      <a href={u(`/tv-shows/${next.slug}/`)} style="text-align:right"><span>Next</span>{next.title} →</a>
    </div>
  </section>
</Base>
