---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import { tvShows, u } from '../../lib/site.js';
const items = tvShows();
---
<Base title="TV Shows" current="/tv-shows/" description="TV shows and long-form productions by ONES — documentary series, reality formats and branded entertainment across Europe and South East Asia.">
  <h1 class="sr-only">TV Shows</h1>
  <section class="work work--list work--flush" aria-label="TV shows">
    <div class="reel reel--tight">
      {items.map((p, i) => <Tile item={p} mode="link" href={u(`/tv-shows/${p.slug}/`)} group="tv" showCredits={false} eager={i < 3} />)}
    </div>
  </section>
</Base>
