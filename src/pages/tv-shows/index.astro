---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Tile from '../../components/Tile.astro';
import { tvShows, u } from '../../lib/site.js';
const items = tvShows();
---
<Base title="TV Shows" current="/tv-shows/" description="TV shows and long-form productions by ONES — documentary series, reality formats and branded entertainment across Europe and South East Asia.">
  <PageHero eyebrow="Long form" title="TV Shows." lede="Documentary series, branded entertainment and reality formats produced for international broadcasters across Europe and South&nbsp;East&nbsp;Asia." />
  <section class="work work--list" aria-label="TV shows" style="padding-bottom:clamp(60px,10vh,100px)">
    <div class="reel reel--tight">
      {items.map((p, i) => <Tile item={p} mode="link" href={u(`/tv-shows/${p.slug}/`)} group="tv" showCredits={false} eager={i < 3} />)}
    </div>
  </section>
</Base>
