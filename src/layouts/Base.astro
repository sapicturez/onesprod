---
import '../styles/core.css'; // editable copy of base.css (base.css is locked on disk)
import '../styles/site.css';
import { NAV, FOOTER_NAV, u, site } from '../lib/site.js';
import OnesWordmark from '../components/OnesWordmark.astro';
const BUILD = Date.now().toString(36); // new value on every build -> browsers fetch fresh site.js
const { title, description = 'ONES is an international production and service company operating as a production hub, established in 2012. Bases in Barcelona, Warsaw and Bangkok. TV commercials, TV shows, documentary films, photoshoots and music videos.', sub = true, current = '', ogImage = "/media/og-ones.png" } = Astro.props;
const fullTitle = title ? `${title} — ONES Production` : 'ONES — International Film Production Service | Barcelona · Warsaw · Bangkok';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#ffffff">
<script is:inline>
  /* Theme before first paint: saved choice → light (default for new visitors) */
  (function () {
    var t = null;
    try { t = localStorage.getItem('ones-theme'); } catch (e) {}
    if (t !== 'light' && t !== 'dark') t = 'light';
    document.documentElement.setAttribute('data-theme', t);
    var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', t === 'light' ? '#ffffff' : '#000000');
  })();
</script>
<meta property="og:type" content="website">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="ONES">
<meta property="og:image" content={new URL(u(ogImage), Astro.site).href}>
{ogImage === '/media/og-ones.png' && <><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:type" content="image/png"></>}
<meta property="og:image:alt" content="ONES">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={new URL(u(ogImage), Astro.site).href}>
<link rel="canonical" href={canonical}>
<link rel="icon" href={u('/favicon.ico?v=3')} sizes="48x48">
<link rel="icon" href={u('/favicon-32.png?v=3')} type="image/png" sizes="32x32">
<link rel="icon" href={u('/favicon-16.png?v=3')} type="image/png" sizes="16x16">
<link rel="apple-touch-icon" href={u('/apple-touch-icon.png?v=3')} sizes="180x180">
<link rel="manifest" href={u('/site.webmanifest')}>
<link rel="preconnect" href="https://player.vimeo.com" crossorigin>
<link rel="preload" href={u('/fonts/inter-latin.woff2')} as="font" type="font/woff2" crossorigin>
<style is:inline set:html={`@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url(${u('/fonts/inter-latin.woff2')}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url(${u('/fonts/inter-latin-ext.woff2')}) format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}`}></style>
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class={`site-header${sub ? ' site-header--solid' : ''}`} role="banner">
  <a href={u('/')} class="brand" aria-label="ONES — Home">
    <img src={u('/media/ones-main.webp')} alt="ONES" width="258" height="153" fetchpriority="high">
  </a>
  {sub && (
    <>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation"><span></span><span></span><span></span></label>
      <nav class="site-nav" aria-label="Primary">
        <label for="nav-toggle" class="nav-close" aria-label="Close navigation">✕</label>
        {NAV.map(([href, label]) => <a href={u(href)} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
        <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Light version" title="Dark / light version" data-theme-toggle><span class="theme-toggle__knob"></span></button>
        <div class="nav-contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={`tel:${site.contact_person.phone.replace(/\s/g, '')}`}>{site.contact_person.phone}</a>
        </div>
      </nav>
    </>
  )}
</header>

<aside class={`social-rail${sub ? '' : ' social-rail--on-media'}`} aria-label="ONES on social media">
  <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
  <a href={site.social.vimeo} target="_blank" rel="noopener">Vimeo</a>
  <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>
  <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
</aside>

<main id="main" class={sub ? 'sub' : undefined}>
  <slot />
</main>

<footer class="site-footer" role="contentinfo">
  <div class="wrap site-footer__grid">
    <p class="site-footer__brand">
      <OnesWordmark class="site-footer__mark" />
      <span>© <time>{new Date().getFullYear()}</time></span>
      <span class="site-footer__tag">International production and service company</span>
    </p>
    <p class="site-footer__cities">Barcelona <i>·</i> Warsaw <i>·</i> Bangkok</p>
    <nav class="site-footer__links" aria-label="ONES on social media and email">
      {FOOTER_NAV.map(([href, label]) => <a href={u(href)}>{label}</a>)}
      <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
      <a href={site.social.vimeo} target="_blank" rel="noopener">Vimeo</a>
      <a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a>
      <a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="site-footer__mail" href={`mailto:${site.email}`}>{site.email}</a>
    </nav>
    <p class="site-footer__mobile-mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
  </div>
  <div class="wrap site-footer__big" aria-hidden="true"><OnesWordmark class="site-footer__giant" /></div>
</footer>

<div class="lb" id="lb" hidden aria-hidden="true" role="dialog" aria-label="Media viewer">
  <div class="lb__bd" data-lb-close></div>
  <img class="lb__brand" src={u('/media/ones-logo-color-nav.png')} alt="ONES" width="461" height="274" loading="lazy" decoding="async">
  <button class="lb__close" type="button" data-lb-close aria-label="Close">✕ close</button>
  <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Previous">←</button>
  <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Next">→</button>
  <div class="lb__stage">
    <div class="lb__frame" id="lb-frame"></div>
    <p class="lb__title" id="lb-title"></p>
    <p class="lb__count" id="lb-count"></p>
  </div>
</div>

<script is:inline defer src={u('/site.js') + '?v=' + BUILD}></script>
</body>
</html>
